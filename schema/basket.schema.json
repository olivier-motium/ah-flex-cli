{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ah-flex.invalid/basket.schema.json",
  "title": "AH Flex basket",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "region", "title", "brief", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "region": { "const": "be" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "brief": { "type": "string", "minLength": 1, "maxLength": 500 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "query", "quantity", "storage", "uses", "selected"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "query": { "type": "string", "minLength": 1, "maxLength": 160 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 50 },
        "storage": { "enum": ["pantry", "freezer", "fresh"] },
        "uses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 },
        "selected": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/selectedProduct" }
          ]
        }
      }
    },
    "selectedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "price_eur", "pack", "availability", "checked_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.ah\\.be/producten/product/wi[0-9]+(?:/[^/?#]+)?/?$"
        },
        "product_id": { "type": "string", "pattern": "^wi[0-9]+$" },
        "price_eur": { "type": "number", "exclusiveMinimum": 0 },
        "pack": { "type": "string", "minLength": 1, "maxLength": 80 },
        "unit_price_eur": { "type": "number", "exclusiveMinimum": 0 },
        "unit_price_basis": { "enum": ["kg", "l", "stuk"] },
        "promotion": { "type": ["string", "null"] },
        "availability": { "enum": ["available", "unavailable", "unknown"] },
        "checked_at": { "type": "string", "format": "date-time" }
      },
      "dependentRequired": {
        "unit_price_eur": ["unit_price_basis"],
        "unit_price_basis": ["unit_price_eur"]
      }
    }
  }
}
